{
  "name": "career-track",
  "version": "1.0.0",
  "private": true,
  "description": "CareerTrack – Smart Job Application & Career Management System (MERN)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
