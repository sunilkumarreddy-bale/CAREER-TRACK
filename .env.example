# ---- Required ----
# MongoDB connection string (local, Docker or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/careertrack
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ---- Server ----
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=7d
# Number of reverse proxies in front of the app (Render/Railway/Nginx = 1)
TRUST_PROXY=1
MAX_RESUME_MB=5

# ---- Cookies / CORS ----
# Leave CLIENT_ORIGIN empty when the API serves the React build (single deployment).
# For a separately hosted frontend set it (comma separated) and use COOKIE_SAMESITE=none.
CLIENT_ORIGIN=
COOKIE_SAMESITE=lax
# Defaults to true in production. Set false only for plain-HTTP self-hosting.
# COOKIE_SECURE=true

# ---- Email reminders (optional) ----
# Without SMTP_HOST the app still shows reminders in-app; emails are skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerTrack <no-reply@example.com>
# Public URL used for links in emails
APP_URL=http://localhost:5000
INTERVIEW_REMINDER_CRON=*/15 * * * *
FOLLOWUP_DIGEST_CRON=0 8 * * *
SCHEDULER_TIMEZONE=UTC
